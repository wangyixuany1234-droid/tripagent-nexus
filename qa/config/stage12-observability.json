  "alerts": {
    "ruleFile": "infrastructure/prometheus/rules/tripagent-stage12-alerts.yml",
    "requiredAnnotationKeys": ["service", "environment", "impact", "dashboard", "runbook", "correlation"],
    "faults": [
      {"id": "api_5xx_rise", "alertName": "TripAgentApi5xxRateHigh", "operator": ">", "threshold": 0.02, "normalValue": 0.001, "faultValue": 0.08, "targetMinutes": 5},
      {"id": "p95_latency_rise", "alertName": "TripAgentApiP95LatencyHigh", "operator": ">", "threshold": 2, "normalValue": 0.8, "faultValue": 3.5, "targetMinutes": 10},
      {"id": "kafka_lag_growth", "alertName": "TripAgentKafkaLagGrowing", "operator": ">", "threshold": 100, "normalValue": 0, "faultValue": 350, "targetMinutes": 10},
      {"id": "db_pool_exhaustion", "alertName": "TripAgentDbPoolSaturation", "operator": ">", "threshold": 0.9, "normalValue": 0.35, "faultValue": 0.98, "targetMinutes": 5},
      {"id": "model_429", "alertName": "TripAgentModel429RateHigh", "operator": ">", "threshold": 0.1, "normalValue": 0, "faultValue": 0.5, "targetMinutes": 5},
      {"id": "agent_failure_rate", "alertName": "TripAgentAgentFailureRateHigh", "operator": ">", "threshold": 0.05, "normalValue": 0.01, "faultValue": 0.2, "targetMinutes": 10},
      {"id": "dead_letter_growth", "alertName": "TripAgentDeadLetterGrowing", "operator": ">", "threshold": 0, "normalValue": 0, "faultValue": 4, "targetMinutes": 5},
      {"id": "long_running_task", "alertName": "TripAgentLongRunningTasks", "operator": ">", "threshold": 900, "normalValue": 120, "faultValue": 1800, "targetMinutes": 15},
      {"id": "disk_low", "alertName": "TripAgentDiskCapacityLow", "operator": "<", "threshold": 0.1, "normalValue": 0.4, "faultValue": 0.05, "targetMinutes": 10}
    ]
  },
