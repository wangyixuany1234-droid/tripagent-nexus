<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.tripagent.nexus</groupId>
  <artifactId>tripagent-nexus</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>TripAgent Nexus</name>

  <modules>
    <module>apps/trip-agent-api</module>
  </modules>

  <properties>
    <a2a-java-sdk.version>1.3.0.Final</a2a-java-sdk.version>
    <jacoco.branch.minimum>0.0</jacoco.branch.minimum>
    <jacoco.instruction.minimum>0.0</jacoco.instruction.minimum>
    <jacoco.report.directory>${project.reporting.outputDirectory}/jacoco</jacoco.report.directory>
    <java.version>21</java.version>
    <mcp-java-sdk.version>2.0.1</mcp-java-sdk.version>
    <netty.version>4.1.138.Final</netty.version>
    <postgresql.version>42.7.12</postgresql.version>
    <resilience4j.version>2.4.0</resilience4j.version>
    <failsafe.reportsDirectory>${project.build.directory}/failsafe-reports</failsafe.reportsDirectory>
    <spring-ai.version>1.1.8</spring-ai.version>
    <springdoc.version>2.8.13</springdoc.version>
    <surefire.reportsDirectory>${project.build.directory}/surefire-reports</surefire.reportsDirectory>
    <testcontainers.version>1.21.3</testcontainers.version>
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.1</version>
        <configuration>
          <java>
            <googleJavaFormat/>
            <formatAnnotations/>
            <removeUnusedImports/>
            <trimTrailingWhitespace/>
            <endWithNewline/>
          </java>
          <pom>
            <sortPom/>
          </pom>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
