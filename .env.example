# Runtime profile
SPRING_PROFILES_ACTIVE=local
APP_ENV=development
TRIP_AGENT_API_PORT=8080
AI_RETRIEVAL_SERVICE_PORT=8000
WEB_PORT=5173
AI_RETRIEVAL_BASE_URL=http://localhost:8000
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_USER_AUTH_ENABLED=true
VITE_OIDC_AUTHORITY=https://auth.example.invalid
VITE_OIDC_CLIENT_ID=tripagent-web
VITE_OIDC_SCOPE=openid profile
USER_AUTH_ENABLED=true
# Configure these values from the trusted OIDC provider. The placeholder issuer/JWK defaults fail closed.
AUTH_ISSUER_URI=https://auth.example.invalid
AUTH_AUDIENCE=tripagent-api
AUTH_JWK_SET_URI=https://auth.example.invalid/.well-known/jwks.json
PLAN_SUBMISSION_LIMIT_PER_MINUTE=10
DEVELOPER_TOOLS_ENABLED=true
JAEGER_BASE_URL=http://localhost:16686
DEVELOPER_TRACE_TIMEOUT=3s
PROMPT_INJECTION_ENABLED=true
ALLOWED_EXTERNAL_HOSTS=localhost,127.0.0.1,ai-retrieval-service,trip-agent-api,api.deepseek.com,tile.openstreetmap.org

# World map tiles are fetched only by Spring Boot; the browser never contacts this host directly.
MAP_TILES_ENABLED=true
MAP_TILE_BASE_URL=https://tile.openstreetmap.org
MAP_TILE_USER_AGENT=TripAgent-Nexus/0.1
MAP_TILE_CONNECT_TIMEOUT=3s
MAP_TILE_READ_TIMEOUT=8s
MAP_TILE_MAX_ZOOM=19
MAP_TILE_MAX_BYTES=1048576

# Upload policy
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_STORAGE_ROOT=./data/uploads
UPLOAD_MAX_PIXELS=40000000
UPLOAD_MAX_PDF_PAGES=20
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf
DOCUMENT_PARSE_LOCALE=zh-CN
DOCUMENT_CRITICAL_CONFIDENCE_THRESHOLD=0.7500
DOCUMENT_PROCESSING_MESSAGING_ENABLED=true
AI_DOCUMENT_TIMEOUT=90s

# DeepSeek model configuration
# DEEPSEEK_API_KEY must be injected from a server-side secret store or environment.
# Docker Compose forwards DEEPSEEK_API_KEY only to backend services.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding
DEEPSEEK_API_KEY=
MODEL_GATEWAY_PROVIDER=deepseek
MODEL_FALLBACK_PROVIDER=none
MODEL_ALLOW_MOCK_FALLBACK=false
MODEL_TIMEOUT=15s
MODEL_MAX_ATTEMPTS=3
MODEL_INITIAL_BACKOFF=200ms
MODEL_BACKOFF_MULTIPLIER=2.0
MODEL_MAX_CONCURRENCY=8
# Set a finite value only for bounded test runs such as the real-model Canary.
MODEL_MAX_TOTAL_CALLS=2147483647
MODEL_MAX_RESPONSE_CHARS=262144
MODEL_CONCURRENCY_WAIT=100ms
DOCUMENT_PARSER_MODE=deepseek
DOCUMENT_PARSER_VERSION=document-parser-1.0.0
DOCUMENT_PARSER_TIMEOUT_SECONDS=60
TESSERACT_COMMAND=tesseract
PDFINFO_COMMAND=pdfinfo
PDFTOPPM_COMMAND=pdftoppm

# Retrieval and GraphRAG
RETRIEVAL_PROVIDER_MODE=deepseek
RETRIEVAL_EMBEDDING_DIMENSIONS=1024
RETRIEVAL_TIMEOUT_SECONDS=30
RETRIEVAL_MAX_CANDIDATES=40
RETRIEVAL_MIN_RELEVANCE_SCORE=0.12
RETRIEVAL_CONTEXT_MAX_CHARS=6000
GRAPH_STORE_MODE=neo4j

# MCP and A2A Agent orchestration
AGENT_ORCHESTRATION_ENABLED=true
MCP_BASE_URL=http://localhost:8080
MCP_ENDPOINT=/mcp
# MCP_SERVICE_TOKEN must be injected as a backend-only service credential.
MCP_SERVICE_TOKEN=
MCP_REQUEST_TIMEOUT=10s
MCP_MAX_REQUEST_SIZE=1048576
MCP_PROVIDER_MODE=LIVE
MCP_EXPECTED_SERVER_NAME=tripagent-tools-mcp
MCP_EXPECTED_SERVER_VERSION=1.0.0

# End-to-end planning workflow
PLANNING_ENABLED=true
PLANNING_PROVIDER_MODE=LIVE
PLANNING_TENANT_ID=00000000-0000-0000-0000-000000000001
PLANNING_TOKEN_BUDGET=12000
PLANNING_CANDIDATE_TARGET=2
PLANNING_MAX_AUTO_REPLANS=1
PLANNING_DEFAULT_COMMUTE_MINUTES=45
PLANNING_CHECKPOINT_RETENTION=24h
PLANNING_MAX_CONCURRENT_WORKFLOWS=4
PLANNING_CHECKPOINT_CLEANUP_INTERVAL=1h

# Async governance
ASYNC_GOVERNANCE_ENABLED=true
ASYNC_REDIS_ENABLED=true
PLAN_REQUESTED_TOPIC=trip.plan.requested
DOCUMENT_PARSE_REQUESTED_TOPIC=document.parse.requested
DOCUMENT_PARSE_COMPLETED_TOPIC=document.parse.completed
RETRIEVAL_REQUESTED_TOPIC=retrieval.requested
AGENT_TASK_REQUESTED_TOPIC=agent.task.requested
AGENT_TASK_COMPLETED_TOPIC=agent.task.completed
PLAN_REVIEW_REQUESTED_TOPIC=plan.review.requested
PLAN_COMPLETED_TOPIC=plan.completed
TASK_FAILED_TOPIC=task.failed
DEAD_LETTER_TOPIC=dead-letter
ASYNC_MAX_EVENT_BYTES=262144
ASYNC_MAX_ATTEMPTS=5
ASYNC_INITIAL_BACKOFF=1s
ASYNC_MAXIMUM_BACKOFF=30s
ASYNC_PUBLISH_TIMEOUT=5s
ASYNC_OUTBOX_POLL_INTERVAL=500ms
ASYNC_STALE_TASK_THRESHOLD=5m
ASYNC_RECOVERY_POLL_INTERVAL=30s
ASYNC_MAX_RECOVERY_ATTEMPTS=1
ASYNC_EXTERNAL_CALL_TIMEOUT=90s
ASYNC_EXTERNAL_MAX_CONCURRENCY=8
ASYNC_EXTERNAL_CIRCUIT_WINDOW=10
ASYNC_EXTERNAL_CIRCUIT_MINIMUM_CALLS=5
ASYNC_EXTERNAL_CIRCUIT_FAILURE_RATE=50
ASYNC_EXTERNAL_CIRCUIT_OPEN_DURATION=10s
ASYNC_EXTERNAL_CIRCUIT_HALF_OPEN_CALLS=1
KAFKA_CONSUMER_SESSION_TIMEOUT_MS=10000
KAFKA_CONSUMER_HEARTBEAT_INTERVAL_MS=3000
ASYNC_OPERATIONS_REPLAY_LIMIT_PER_MINUTE=10
# Inject this backend-only credential from a secret store outside local development.
ASYNC_OPERATIONS_TOKEN=

# Use mock modes explicitly when no DeepSeek key is available.
# Never enable a Mock provider in production.
# SPRING_PROFILES_ACTIVE=mock-model
# DOCUMENT_PARSER_MODE=mock
# RETRIEVAL_PROVIDER_MODE=mock
# MCP_PROVIDER_MODE=MOCK
# PLANNING_PROVIDER_MODE=MOCK

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=tripagent
POSTGRES_USERNAME=tripagent
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_PUBLIC_DATABASE=travel-public
NEO4J_USER_MEMORY_DATABASE=user-memory

# LanceDB
LANCEDB_URI=./data/lancedb
LANCEDB_PUBLIC_TABLE=travel_public
LANCEDB_USER_MEMORY_TABLE=user_memory

# OpenTelemetry
OTEL_SERVICE_NAME=trip-agent-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_ENABLED=true
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
JAEGER_UI_PORT=16686

# Service-to-service authentication
# Inject this backend-only credential from a local shell or secret store.
AI_SERVICE_TOKEN=
